{
   "action": {
      "default_icon": "assets/logo-colour-48x48.png",
      "default_popup": "./popup/index.html"
   },
   "browser_specific_settings": {
      "gecko": {
         "data_collection_permissions": {
            "required": [ "authenticationInfo", "websiteContent" ]
         },
         "id": "quiz-solver@quizsolverformoodle.com",
         "strict_min_version": "128.0"
      }
   },
   "content_scripts": [ {
      "js": [ "MoodleBridge.js" ],
      "matches": [ "*://*/**/mod/quiz/attempt.php*", "*://*/mod/quiz/attempt.php*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "js": [ "QuizSolver.js" ],
      "matches": [ "*://*/**/mod/quiz/attempt.php*", "*://*/mod/quiz/attempt.php*" ],
      "run_at": "document_end"
   } ],
   "description": "Ace every quiz with AI-powered answers for Moodle.",
   "host_permissions": [ "*://*/*" ],
   "icons": {
      "128": "assets/logo-colour-128x128.png",
      "16": "assets/logo-colour-16x16.png",
      "32": "assets/logo-colour-32x32.png",
      "48": "assets/logo-colour-48x48.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "111",
   "name": "Quiz Solver for Moodle",
   "permissions": [ "storage" ],
   "short_name": "Quiz Solver",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.0.2"
}
